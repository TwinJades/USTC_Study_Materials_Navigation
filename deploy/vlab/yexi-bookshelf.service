[Unit]
Description=也西书架 vLab 自托管站点（127.0.0.1:8080，服务 current 版本）
Documentation=https://github.com/TwinJades/USTC_Study_Materials_Navigation
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=YEXI_VLAB_PORT=8080
Environment=YEXI_STATS_DB=%h/.local/share/yexi-bookshelf/shared/visits.db
WorkingDirectory=%h/.local/share/yexi-bookshelf
ExecStart=/usr/bin/env node %h/.local/share/yexi-bookshelf/current/scripts/serve.mjs --vlab
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=yes

[Install]
WantedBy=default.target
